NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://consusimples:dev@localhost:5442/consusimples
JWT_ACCESS_SECRET=CHANGE_ME_at_least_32_characters_long_secret
JWT_REFRESH_SECRET=CHANGE_ME_another_32_characters_long_secret
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY_HOPS=1
APP_VERSION=dev
SERVICE_NAME=api
LOG_LEVEL=info
RESEND_API_KEY=CHANGE_ME
MAIL_FROM=nao-responda@consusimples.local
WEB_BASE_URL=http://localhost:3000

# apps/web
API_INTERNAL_URL=http://localhost:3001
NEXT_PUBLIC_APP_ENV=dev

# --- só no .env da VPS (docker-compose.prod.yml). Nada disso vai para o git. ---
# GIT_SHA=          # tag da imagem que está no ar; o deploy exporta antes do `up`
# POSTGRES_USER=consusimples
# POSTGRES_PASSWORD=  # openssl rand -base64 32
# POSTGRES_DB=consusimples
# DATABASE_URL=postgresql://consusimples:<senha>@postgres:5432/consusimples
# backup (lido pelo cron, não pelo compose):
# BACKUP_PASSPHRASE=  # openssl rand -base64 48, guardada TAMBÉM fora da VPS
# BACKUP_REMOTE=b2:consusimples-backup
